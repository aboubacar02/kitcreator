# ================================================
# KitCreator - Configuration
# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.local sur GitHub !
# ================================================

# --- Supabase (obligatoire) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- IA : AUCUNE cle dans le frontend ! ---
# Les appels fournisseurs passent par l'Edge Function
# supabase/functions/generate (secrets SERVEUR uniquement).
#
# Une cle par fournisseur suffit :
#   supabase secrets set GEMINI_API_KEY=... GROQ_API_KEY=...
#
# Rotation multi-cles (optionnel) : jusqu'a 6 cles PAR FOURNISSEUR,
# chacune devant venir d'un COMPTE DIFFERENT pour augmenter le quota :
#   supabase secrets set GEMINI_API_KEY_2=... GROQ_API_KEY_2=...
#   supabase secrets set GEMINI_API_KEY_3=... (jusqu'a _6)
#
# Modeles optionnels (valeurs par defaut integrees) :
#   supabase secrets set GEMINI_MODEL=gemini-3.6-flash \
#     GROQ_MODEL=openai/gpt-oss-120b OPENAI_MODEL=gpt-4o-mini
#
# Puis deployez la fonction :
#   supabase functions deploy generate

# --- Paiements Stripe / Lemon Squeezy (liens checkout) ---
VITE_CHECKOUT_STARTER=
VITE_CHECKOUT_PRO=
VITE_CHECKOUT_AGENCY=

# --- Google OAuth (optionnel - la connexion Google passe par Supabase) ---
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
