# ================================================
# KitCreator - Configuration
# Copiez ce fichier en ".env.local" puis remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.local sur GitHub !
# ================================================

# --- Supabase (obligatoire) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- IA: rotation de cles (Gemini = AQ./AIza..., Groq = gsk_...) ---
# Le fournisseur est detecte automatiquement par prefixe.
VITE_AI_API_KEY=
VITE_AI_KEY_1=
VITE_AI_KEY_2=
VITE_AI_KEY_3=
VITE_AI_KEY_4=
VITE_AI_KEY_5=
VITE_AI_KEY_6=

# --- IA: endpoint personnalise (optionnel, sinon auto-detecte) ---
VITE_AI_API_URL=https://api.openai.com/v1/chat/completions
VITE_AI_MODEL=gpt-4o-mini

# --- Paiements Stripe / Lemon Squeezy (liens checkout) ---
VITE_CHECKOUT_STARTER=
VITE_CHECKOUT_PRO=
VITE_CHECKOUT_AGENCY=

# --- Google OAuth (optionnel - la connexion Google passe par Supabase) ---
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
